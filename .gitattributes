# 统一用 LF 换行，避免 Windows/Linux 协作时整个文件被标成"改动"
* text=auto eol=lf

# 明确按文本处理
*.md   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# 二进制文件不要动
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.exe  binary

# 让 GitHub 的语言统计更准（不要把这些算成"文档"）
docs/* linguist-documentation
